# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://wellsound:yourpassword@localhost:5432/wellsound

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret_key

# Session cookie lifetime in seconds (default 8 hours)
SESSION_EXPIRE_SECONDS=28800

# ── Microsoft OAuth (Azure AD) ────────────────────────────────────────────────
# From your Azure App Registration (see DEPLOY.md for setup steps)
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Must match exactly what you set in Azure App Registration → Redirect URIs
# Local dev:  http://localhost:8000/auth/callback
# Production: http://192.168.1.50/auth/callback  (your server's local IP)
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=WellSound
DEBUG=false

# ── Seed data ─────────────────────────────────────────────────────────────────
# Set to true to load mock wells/measurements on first run
LOAD_SEED_DATA=true
